# Hugging Face Space (Docker SDK): a free CPU demo of NarraReel.
# Online (Edge) and offline (Kokoro) voices; scripts are capped at about two minutes and
# uploads/cloning are off (`--demo`). Cloning is linked to the Colab notebook instead.
# Spaces expect the app on port 7860 and a non-root user with uid 1000.
FROM node:22-slim AS web
WORKDIR /web
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends ffmpeg espeak-ng libsndfile1 \
 && rm -rf /var/lib/apt/lists/* \
 && useradd -m -u 1000 user

WORKDIR /app
COPY pyproject.toml README.md LICENSE THIRD_PARTY_LICENSES.md ./
COPY narrareel ./narrareel
COPY --from=web /web/dist ./narrareel/server/static
RUN pip install --no-cache-dir ".[server,offline]"

USER user
ENV NARRAREEL_HOME=/home/user/.narrareel PYTHONUNBUFFERED=1
EXPOSE 7860
CMD ["narrareel", "serve", "--host", "0.0.0.0", "--port", "7860", "--demo"]
